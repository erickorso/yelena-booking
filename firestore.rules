rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isPatient() {
      return signedIn() && role() == 'paciente';
    }

    function isSpecialist() {
      return signedIn() && role() == 'especialista';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /_meta/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /_health/{docId} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['paciente', 'especialista']
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'locale']);
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /specialists/{specialistId} {
      allow read: if resource.data.status == 'active'
        || isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.status == resource.data.status
          && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.patientId == request.auth.uid
          || resource.data.specialistId == request.auth.uid
        ));
      allow create: if isPatient()
        && request.resource.data.patientId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && (
          resource.data.patientId == request.auth.uid
          || resource.data.specialistId == request.auth.uid
        ));
      allow delete: if isAdmin();
    }

    match /ehrNotes/{noteId} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.patientId == request.auth.uid
          || resource.data.specialistId == request.auth.uid
        ));
      allow create: if isSpecialist()
        && request.resource.data.specialistId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /medicalFiles/{fileId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.patientId == request.auth.uid)
        || (isSpecialist());
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /availabilityRules/{ruleId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || (isSpecialist() && request.resource.data.specialistId == request.auth.uid);
    }

    match /availabilityOverrides/{overrideId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || (isSpecialist() && request.resource.data.specialistId == request.auth.uid);
    }
  }
}
