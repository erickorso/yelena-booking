NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only — never prefix with NEXT_PUBLIC_
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vercel Blob (medical PDFs/images) — Storage Spark alternative
BLOB_READ_WRITE_TOKEN=

# Resend (transactional email). Free: verify domain or use onboarding@resend.dev
RESEND_API_KEY=
MAIL_FROM="Yelena Booking <onboarding@resend.dev>"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar sync (specialist OAuth → FreeBusy + Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; default: ${NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_REDIRECT_URI=
# Optional HMAC secret for OAuth state (defaults to GOOGLE_CLIENT_SECRET)
GOOGLE_OAUTH_STATE_SECRET=

# Cron (Vercel Cron Authorization: Bearer …)
CRON_SECRET=

# Optional — Playwright / screenshots (never commit real values)
